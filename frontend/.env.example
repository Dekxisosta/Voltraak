# Voltraak IMS Frontend Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=Voltraak IMS
VITE_APP_VERSION=1.0.0

# Environment
VITE_APP_ENV=development

# Data source: "mocks" uses local mock data, "api" uses real backend
VITE_DATA_SOURCE=mocks

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_DEBUG_MODE=true

# Authentication
VITE_JWT_STORAGE_KEY=voltraak_token
VITE_API_TOKEN_STORAGE_KEY=voltraak_api_token
VITE_USER_STORAGE_KEY=voltraak_user

# Error Reporting (Optional - for production)
# VITE_SENTRY_DSN=
# VITE_ANALYTICS_ID=

# Weather badge (header) - Open-Meteo needs no API key. These are only
# used as a fallback when the browser denies/lacks geolocation.
# VITE_WEATHER_DEFAULT_LAT=40.7128
# VITE_WEATHER_DEFAULT_LON=-74.0060