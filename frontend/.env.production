# Voltraak IMS Frontend - Production Configuration

# Application
VITE_APP_NAME="Voltraak IMS"
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# API Configuration
VITE_API_BASE_URL=https://api.your-domain.com/api
VITE_API_TIMEOUT=30000

# Authentication
VITE_JWT_STORAGE_KEY=voltraak_token
VITE_API_TOKEN_STORAGE_KEY=voltraak_api_token
VITE_USER_STORAGE_KEY=voltraak_user
VITE_SESSION_TIMEOUT=3600000

# Feature Flags
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# Analytics
VITE_GOOGLE_ANALYTICS_ID=
VITE_HOTJAR_ID=

# Error Reporting
VITE_SENTRY_DSN=

# Performance
VITE_ENABLE_PWA=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_STRATEGY=network-first

# Security
VITE_ENABLE_CSP=true
VITE_TRUSTED_DOMAINS=your-domain.com,api.your-domain.com

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_ANIMATION_ENABLED=true

# Business Configuration
VITE_DEFAULT_LANGUAGE=en
VITE_CURRENCY=USD
VITE_DATE_FORMAT=MM/dd/yyyy
VITE_TIME_FORMAT=HH:mm

# Pagination
VITE_DEFAULT_PAGE_SIZE=15
VITE_MAX_PAGE_SIZE=100

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,xlsx,csv