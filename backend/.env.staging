# Voltraak IMS - Staging Environment Configuration

# Application
APP_NAME="Voltraak IMS (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.your-domain.com

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=voltraak_ims_staging
DB_USERNAME=voltraak_staging
DB_PASSWORD=

# Cache Configuration
CACHE_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Queue Configuration
QUEUE_CONNECTION=redis

# Mail Configuration (Use development SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="staging@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT Configuration
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# File Storage (Local for staging)
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Performance (Disabled for staging)
OPCACHE_ENABLE=0

# Security (Relaxed for staging)
SECURE_COOKIES=false

# IMS Configuration (Test mode)
IMS_FEFO_STRICT_MODE=false
IMS_AUTO_REORDER_ENABLED=false
IMS_BATCH_EXPIRY_WARNING_DAYS=30
IMS_VARIANCE_ALERT_THRESHOLD=10
IMS_MAX_BATCH_SIZE=1000

# Testing
TELESCOPE_ENABLED=true
CLOCKWORK_ENABLE=true