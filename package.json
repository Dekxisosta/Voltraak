{
    "name": "voltraak-ims",
    "version": "1.0.0",
    "description": "Voltraak Inventory Management System",
    "type": "module",
    "scripts": {
        "dev":            "vite",
        "build":          "vite build",
        "lint":           "eslint resources/js --ext js,jsx --report-unused-disable-directives",
        "lint:fix":       "eslint resources/js --ext js,jsx --fix",
        "preview":        "vite preview",
        "format":         "prettier --write \"resources/js/**/*.{js,jsx,json,css,md}\"",
        "format:check":   "prettier --check \"resources/js/**/*.{js,jsx,json,css,md}\"",
        "test":           "vitest",
        "test:ui":        "vitest --ui",
        "coverage":       "vitest run --coverage"
    },
    "dependencies": {
        "@inertiajs/react":    "^2.3.28",
        "clsx":                "^2.0.0",
        "laravel-vite-plugin": "^1.3.0",
        "lucide-react":        "^0.294.0",
        "react":               "^18.2.0",
        "react-dom":           "^18.2.0",
        "react-router-dom":    "^6.20.1",
        "recharts":            "^2.12.7",
        "tailwind-merge":      "^2.0.0"
    },
    "devDependencies": {
        "@babel/eslint-parser":          "^7.29.7",
        "@babel/preset-react":           "^7.29.7",
        "@testing-library/jest-dom":     "^6.1.5",
        "@testing-library/react":        "^13.4.0",
        "@testing-library/user-event":   "^14.5.1",
        "@vitejs/plugin-react":          "^4.1.1",
        "@vitest/ui":                    "^1.0.0",
        "autoprefixer":                  "^10.4.16",
        "eslint":                        "^8.53.0",
        "eslint-import-resolver-alias":  "^1.1.2",
        "eslint-plugin-import":          "^2.32.0",
        "eslint-plugin-react":           "^7.37.5",
        "eslint-plugin-react-hooks":     "^4.6.0",
        "eslint-plugin-react-refresh":   "^0.4.4",
        "eslint-plugin-unused-imports":  "^4.4.1",
        "jsdom":                         "^23.0.0",
        "postcss":                       "^8.4.32",
        "prettier":                      "^3.1.0",
        "tailwindcss":                   "^3.3.6",
        "vite":                          "^5.0.0",
        "vitest":                        "^1.0.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm":  ">=8.0.0"
    }
}
